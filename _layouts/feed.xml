---
layout: none
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://w3.org">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <link>{{ site.url }}{{ site.baseurl }}/</link>
    <atom:link href="{{ site.url }}{{ site.baseurl }}/feed.xml" rel="self" type="application/rss+xml" />
    <description>{{ site.description | xml_escape }}</description>
    <language>en</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>

    {% comment %} Tüm koleksiyonları güvenli bir şekilde birleştiriyoruz {% endcomment %}
    {% assign all_content = "" | split: "," %}
    {% if site.blog %}{% assign all_content = all_content | concat: site.blog %}{% endif %}
    {% if site.notes %}{% assign all_content = all_content | concat: site.notes %}{% endif %}
    {% if site.photos %}{% assign all_content = all_content | concat: site.photos %}{% endif %}
    {% if site.bookmarks %}{% assign all_content = all_content | concat: site.bookmarks %}{% endif %}
    
    {% assign sorted_content = all_content | sort: 'date' | reverse %}
    
    {% comment %} RSS standartları için en güncel 50 gönderiyi listelemek idealdir, sınırı kaldırmak isterseniz limit: 50 kısmını silebilirsiniz {% endcomment %}
    {% for item in sorted_content limit: 50 %}
      <item>
        <title>{% if item.title %}{{ item.title | xml_escape }}{% else %}{{ item.date | date: "%B %d, %Y" }}{% endif %}</title>
        <link>{{ site.url }}{{ item.url }}</link>
        <pubDate>{{ item.date | date_to_rfc822 }}</pubDate>
        <guid isPermaLink="true">{{ site.url }}{{ item.url }}</guid>
        {% if item.image %}
        <enclosure url="{{ item.image | absolute_url }}" type="image/jpeg" length="0" />
        {% endif %}
        <description><![CDATA[
          {% if item.image %}
            <p><img src="{{ item.image | absolute_url }}" alt="{{ item.title | xml_escape }}" style="max-width:100%; height:auto;"></p>
          {% endif %}
          {% if item.location %}
            <p><strong>📍 {{ item.location | xml_escape }}</strong></p>
          {% endif %}
          {% if item.content %}
            {{ item.content }}
          {% else %}
            <p>{{ item.title | xml_escape }}</p>
          {% endif %}
        ]]></description>
      </item>
    {% endfor %}
  </channel>
</rss>